# =============================================================================
# Omni Heaven Commercial Platform - Environment Configuration Example
# =============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=omniheaven
POSTGRES_PASSWORD=replace_with_a_strong_password_here
POSTGRES_DB=omniheaven_prod
DATABASE_URL=postgresql://omniheaven:replace_with_a_strong_password_here@localhost:5432/omniheaven_prod

# Better Auth Authentication
BETTER_AUTH_SECRET=generate_a_random_32_character_string_here
BETTER_AUTH_URL=http://localhost:4000
AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
# Set in production only (e.g. .omniheaven.com) to scope session cookies.
COOKIE_DOMAIN=

# Seed / Bootstrap Credentials
# Required in production: seeding refuses to run with built-in demo passwords.
SEED_DEFAULT_PASSWORD=
SUPERADMIN_EMAIL=admin@omniheaven.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Super Admin

# SMTP (Mailpit in dev; transactional provider in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@omniheaven.com
SMTP_SECURE=false

# In-Memory Cache & Rate Limiting (Valkey 8 / Redis)
REDIS_URL=redis://localhost:6379

# API Backend URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Object Storage: SeaweedFS (Apache 2.0 / S3-compatible)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=omniheaven_seaweed_access
S3_SECRET_ACCESS_KEY=omniheaven_seaweed_secret
S3_BUCKET=omniheaven-assets

# Bangladesh Payment Gateway: Paystation (https://paystation.com.bd/)
PAYSTATION_MERCHANT_ID=your_merchant_id
PAYSTATION_API_KEY=your_paystation_api_key
PAYSTATION_IS_LIVE=false

# Mobile Money Direct APIs (Optional Direct Webhooks)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# International Gateway: Stripe (Optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudflare Tunnel Token (For *.omniheaven.com wildcard ingress)
CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# Observability, Telemetry & Log Aggregation (Loki, Tempo, Prometheus, Grafana)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_password
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Telegram Bot Instant Alerting (Grafana Alerting -> Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# Error Tracking & Crash Reporting (Self-hosted or Cloud Sentry)
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# Privacy-First Analytics (Self-hosted Plausible Analytics)
# =============================================================================
PLAUSIBLE_DB_USER=plausible
PLAUSIBLE_DB_PASSWORD=replace_with_a_strong_plausible_db_password
PLAUSIBLE_DB_NAME=plausible
PLAUSIBLE_BASE_URL=http://localhost:8000
PLAUSIBLE_SECRET_KEY_BASE=generate_a_random_64_character_secret_key_base_here
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=omniheaven.com
NEXT_PUBLIC_PLAUSIBLE_HOST=http://localhost:8000

